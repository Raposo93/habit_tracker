#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_DIR"

if ! command -v java >/dev/null 2>&1; then
    echo "Error: Java is required to run the CLI. Install Java and try again." >&2
    exit 1
fi

JAR_PATH="$PROJECT_DIR/target/habit-tracker-0.4.0.jar"
if [[ ! -f "$JAR_PATH" ]]; then
    echo "Error: packaged application was not found. Run 'mvn verify' in $PROJECT_DIR first." >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    exec java -jar "$JAR_PATH" --help
fi

exec java -jar "$JAR_PATH" "$@"
