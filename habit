#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_DIR"

if ! command -v java >/dev/null 2>&1; then
    echo "Error: Java is required to run the CLI. Install Java and try again." >&2
    exit 1
fi

shopt -s nullglob
jars=("$PROJECT_DIR"/target/habit-tracker-*.jar)
if [[ ${#jars[@]} -eq 0 ]]; then
    echo "Error: packaged application was not found. Run 'mvn verify' in $PROJECT_DIR first." >&2
    exit 1
fi

JAR_PATH="${jars[0]}"
for jar in "${jars[@]:1}"; do
    if [[ "$jar" -nt "$JAR_PATH" ]]; then
        JAR_PATH="$jar"
    fi
done

if [[ $# -eq 0 ]]; then
    exec java -jar "$JAR_PATH" --help
fi

exec java -jar "$JAR_PATH" "$@"
